# Application
NEXT_PUBLIC_SITE_NAME="Alex Bereanu Photography"
NEXT_PUBLIC_SITE_URL="https://domain.example"
NEXT_PUBLIC_WEDDINGS_URL="https://weddings.domain.example"
WEDDINGS_DOMAIN="weddings.domain.example"
ADMIN_PANEL_BASE_URL="https://domain.example/admin"

# Security
# Production defaults to Google-only admin authentication. Development defaults to both.
ADMIN_AUTH_MODE="google"
# Irreversible Admin actions require a session authenticated within this window.
ADMIN_STEP_UP_MAX_AGE_SECONDS="600"
# Separate random secrets, each at least 32 characters. Do not reuse values.
OAUTH_STATE_SECRET=""
GALLERY_ACCESS_SECRET=""
CSRF_SECRET=""
# Separate HMAC secrets used to pseudonymize audit and distributed limiter identities.
AUDIT_LOG_SECRET=""
RATE_LIMIT_SECRET=""
# Protects GET /api/health?deep=1 from exposing operational queue state.
HEALTH_CHECK_SECRET=""
# Authenticates direct calls to the durable media-worker endpoint.
MEDIA_WORKER_SECRET=""
# Vercel automatically sends this value as a Bearer token to cron routes.
CRON_SECRET=""
# Required before ZIP uploads can be published. The scanner must fetch a
# short-lived URL and return { clean: true, sha256: "<hex>" }.
MEDIA_SCANNER_URL=""
MEDIA_SCANNER_SECRET=""
# Only set while deliberately provisioning the first password-based admin.
# Remove it immediately after setup succeeds. Setup is disabled when this is empty.
ADMIN_SETUP_TOKEN=""
# Google OAuth admin login. Add the callback URL in Google Cloud:
# https://domain.example/api/admin/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional override if your public callback URL differs from the incoming request URL.
GOOGLE_OAUTH_REDIRECT_URI=""
# Comma-separated Google account emails that may access /admin.
ADMIN_GOOGLE_ALLOWED_EMAILS="you@gmail.com"

# Database (Neon Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
# Non-pooled provider endpoint used only by Prisma migration commands.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=verify-full"

# Phase 0 operator checkpoint. Configure these only in the isolated staging
# environment; never commit provider references or connection strings.
PHASE0_RESTORE_DATABASE_URL="postgresql://USER:PASSWORD@ISOLATED_RESTORE_HOST/DB?sslmode=verify-full"
PHASE0_BACKUP_PROVIDER=""
PHASE0_BACKUP_REFERENCE=""
PHASE0_BACKUP_CREATED_AT=""
PHASE0_BACKUP_ENCRYPTED="false"
PHASE0_RESTORE_REFERENCE=""
PHASE0_RESTORE_ISOLATED="false"
PHASE0_STORAGE_RESTORE_REFERENCE=""
PHASE0_STORAGE_RESTORE_VERIFIED="false"
PHASE0_SYNTHETIC_REPORT_REFERENCE=""
PHASE0_SYNTHETIC_AUTHORIZATION_VERIFIED="false"
PHASE0_IOS_SAVE_VERIFIED="false"
PHASE0_ANDROID_SAVE_VERIFIED="false"

# Enable only after the Phase 2 additive migration passes the staging and
# backup/restore gates. Keep false during the schema-compatible deployment step.
ADMIN_GALLERY_PHASE2_ENABLED="false"
GALLERY_RECYCLE_RETENTION_DAYS="30"
ADMIN_CONTENT_PHASE3_ENABLED="false"
# Enable only after Phase 0 and the Phase 2 + Phase 4 staging migrations pass.
ADMIN_CLIENT_DELIVERY_PHASE4_ENABLED="false"
# Final compatibility retirement. Enable only after the Phase 6 migration,
# storage, delivery, mobile-save, and rollback-observation gates pass.
ADMIN_PHASE6_RELEASE_ENABLED="false"

# Phase 6 operator controls and evidence. Keep approval false except for the
# deliberate migration command. Paths/references belong in ignored operator
# environment files or the deployment secret manager, never in source control.
ADMIN_PHASE6_MIGRATION_APPROVED="false"
PHASE6_STAGING_BASE_URL="https://staging.domain.example"
PHASE6_DELIVERY_VERIFICATION_APPROVED="false"
PHASE6_DELIVERY_MANIFEST_PATH=""
PHASE6_DELIVERY_REPORT_PATH=""
PHASE6_MIGRATION_REPORT_REFERENCE=""
PHASE6_DELIVERY_REPORT_REFERENCE=""
PHASE6_VERIFIED_PRIVATE_GALLERY_DIGEST=""
PHASE6_STORAGE_REPORT_REFERENCE=""
PHASE6_IOS_SAVE_VERIFIED="false"
PHASE6_ANDROID_SAVE_VERIFIED="false"
# Keep the previous deployment, flags, database backup, and storage recovery
# versions available until this ISO-8601 timestamp has passed.
PHASE6_OBSERVATION_ENDS_AT=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Studio <no-reply@domain.example>"
ADMIN_NOTIFICATION_EMAIL="hello@domain.example"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public portfolio/site-content objects. R2_BUCKET_NAME remains a deprecated fallback.
R2_PUBLIC_BUCKET_NAME=""
R2_BUCKET_NAME=""
# Private client-gallery bucket. Do not enable an r2.dev or public custom domain for this bucket.
R2_PRIVATE_BUCKET_NAME=""
R2_REGION="auto"
# This domain must expose only intentionally public portfolio derivatives/site content.
R2_PUBLIC_BASE_URL="https://assets.domain.example"
# The Next image optimizer is intentionally disabled in next.config.ts while its
# bundled Sharp version is under an upstream security advisory.

# Optional anti-spam provider
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Comma-separated exact hostnames returned by Turnstile Siteverify.
TURNSTILE_EXPECTED_HOSTNAMES="domain.example,weddings.domain.example"

# Optional privacy-minimized monitoring webhook. It receives route templates,
# aggregate job counts, CSP origins, and sampled Web Vitals; never request bodies.
OBSERVABILITY_WEBHOOK_URL=""
OBSERVABILITY_WEBHOOK_SECRET=""
WEB_VITALS_SAMPLE_RATE="0.1"

# Operational retention. Client photos are never age-deleted by these settings.
AUDIT_RETENTION_DAYS="365"
# Applies only after Admin Phase 4 is enabled. Photos are never age-deleted.
DELIVERY_LOG_RETENTION_DAYS="365"
EMAIL_LOG_RETENTION_DAYS="90"
# Set only after the business/legal ticket-retention period is approved.
# Recommended starting point after approval: 730.
TICKET_RETENTION_DAYS=""
