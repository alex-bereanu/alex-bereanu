{
  "name": "alex-bereanu-photography",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-env-runner.mjs generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:verify": "node scripts/verify-phase1-security.mjs && node scripts/verify-phase2-media.mjs",
    "security:verify:media": "node scripts/verify-phase2-media.mjs",
    "performance:verify": "node scripts/verify-phase3-performance.mjs",
    "experience:verify": "node scripts/verify-phase4-mobile-resume.mjs",
    "operations:verify": "node scripts/verify-phase5-operations.mjs",
    "quality:verify": "npm run security:verify && npm run performance:verify && npm run experience:verify && npm run operations:verify",
    "dependency:policy": "node scripts/check-dependency-policy.mjs",
    "production:verify": "node scripts/verify-production-config.mjs",
    "deployment:verify": "node scripts/verify-deployment.mjs",
    "release:verify": "npm run lint && npm run typecheck && npm run admin:phase0:verify && npm run admin:phase2:verify && npm run admin:phase3:verify && npm run admin:phase4:verify && npm run admin:phase5:verify && npm run admin:phase6:verify && npm run quality:verify && npm run build && npm run dependency:policy && npm run production:verify",
    "security:audit": "npm audit --omit=dev",
    "db:generate": "node scripts/prisma-env-runner.mjs generate",
    "db:push": "node scripts/prisma-env-runner.mjs db push",
    "db:migrate": "node scripts/prisma-env-runner.mjs migrate dev",
    "db:studio": "node scripts/prisma-env-runner.mjs studio",
    "images:backfill": "tsx scripts/backfill-image-variants.mjs",
    "images:verify:v2": "tsx scripts/verify-v2-image-migration.mjs",
    "images:verify:storage": "tsx scripts/verify-v2-image-storage.mjs",
    "admin:phase0:inventory": "tsx scripts/inventory-admin-phase0.mjs",
    "admin:phase0:verify": "node scripts/verify-admin-phase0.mjs",
    "admin:phase0:infrastructure": "node scripts/verify-admin-phase0-infrastructure.mjs",
    "admin:phase0:checkpoint": "node scripts/verify-admin-phase0-checkpoint.mjs",
    "admin:phase2:verify": "node scripts/verify-admin-phase2.mjs",
    "admin:phase3:verify": "node scripts/verify-admin-phase3.mjs",
    "admin:phase4:verify": "node scripts/verify-admin-phase4.mjs",
    "admin:phase5:verify": "tsx scripts/verify-admin-phase5.mjs",
    "admin:phase6:report": "node scripts/report-admin-phase6.mjs",
    "admin:phase6:migrate": "node scripts/migrate-admin-phase6.mjs",
    "admin:phase6:delivery": "node scripts/verify-admin-phase6-delivery.mjs",
    "admin:phase6:storage": "node scripts/verify-admin-phase6-storage.mjs",
    "admin:phase6:verify": "node scripts/verify-admin-phase6.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "hash-wasm": "^4.12.0",
    "jose": "^6.1.0",
    "next": "^16.2.12",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.4",
    "react-photo-album": "^3.5.1",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "yet-another-react-lightbox": "^3.29.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
