generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GalleryCategory {
  PORTRAITS
  AUTOMOTIVE
  LANDSCAPES
  WEDDINGS
  PRODUCT
  CORPORATE
  CUSTOM
}

enum GalleryVisibility {
  PUBLIC
  PRIVATE
}

enum TicketType {
  BOOKING
  CONTACT
}

enum TicketSource {
  HOMEPAGE_BOOKINGS
  HOMEPAGE_CONTACT
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum ActorType {
  ADMIN
  VISITOR
  SYSTEM
}

enum StorageArea {
  PUBLIC
  PRIVATE
}

enum StorageDeletionStatus {
  PENDING
  COMPLETED
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETING
}

enum ArchiveStatus {
  NONE
  PROCESSING
  READY
  FAILED
}

enum MediaUploadKind {
  GALLERY_ASSET
  GALLERY_ARCHIVE
}

enum MediaUploadStatus {
  CREATED
  UPLOADED
  PROCESSING
  COMPLETED
  REJECTED
  EXPIRED
  ABORTED
}

enum MediaJobType {
  INGEST_IMAGE
  REBUILD_IMAGE
  VERIFY_ARCHIVE
}

enum MediaJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  subject    String
  provider   String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([subject, revokedAt])
  @@index([expiresAt])
}

model Gallery {
  id                   String            @id @default(cuid())
  title                String
  slug                 String            @unique
  description          String?
  category             GalleryCategory
  visibility           GalleryVisibility @default(PUBLIC)
  isActive             Boolean           @default(true)
  archiveObjectKey     String?
  archiveStorageArea   StorageArea       @default(PRIVATE)
  archiveFilename      String?
  archiveUploadedAt    DateTime?
  archiveStatus        ArchiveStatus     @default(NONE)
  archiveContentHash   String?
  archiveSizeBytes     BigInt?
  archiveFailureReason String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  assets         GalleryAsset[]
  shareLinks     GalleryShareLink[]
  uploadSessions MediaUploadSession[]

  @@index([category, isActive])
}

model GalleryAsset {
  id                 String      @id @default(cuid())
  galleryId          String
  storageKey         String      @unique
  sourceStorageArea  StorageArea @default(PRIVATE)
  smallStorageKey    String?     @unique
  smallWidth         Int?
  smallHeight        Int?
  smallSizeBytes     BigInt?
  mediumStorageKey   String?     @unique
  mediumWidth        Int?
  mediumHeight       Int?
  mediumSizeBytes    BigInt?
  largeStorageKey    String?     @unique
  largeWidth         Int?
  largeHeight        Int?
  largeSizeBytes     BigInt?
  status             MediaStatus @default(UPLOADING)
  contentHash        String?
  placeholderDataUrl String?
  sourceVerifiedAt   DateTime?
  readyAt            DateTime?
  failureReason      String?
  processingAttempts Int         @default(0)
  originalFilename   String
  mimeType           String
  fileExtension      String?
  sizeBytes          BigInt
  width              Int?
  height             Int?
  capturedAt         DateTime?
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  gallery        Gallery              @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  processingJobs MediaProcessingJob[]

  @@index([galleryId, sortOrder])
  @@index([galleryId, status, sortOrder])
}

model MediaUploadSession {
  id                     String            @id @default(uuid())
  galleryId              String
  kind                   MediaUploadKind
  status                 MediaUploadStatus @default(CREATED)
  storageArea            StorageArea
  quarantineObjectKey    String            @unique
  reservedAssetId        String?           @unique
  originalFilename       String
  expectedContentType    String
  expectedSizeBytes      BigInt
  expectedSha256         String
  multipartUploadId      String?           @unique
  multipartPartSizeBytes Int?
  multipartStartedAt     DateTime?
  expiresAt              DateTime
  uploadedAt             DateTime?
  completedAt            DateTime?
  failureReason          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  gallery       Gallery             @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  processingJob MediaProcessingJob?

  @@index([galleryId, status, createdAt])
  @@index([status, expiresAt])
}

model MediaProcessingJob {
  id              String         @id @default(cuid())
  type            MediaJobType
  status          MediaJobStatus @default(PENDING)
  uploadSessionId String?        @unique
  assetId         String?
  attempts        Int            @default(0)
  maxAttempts     Int            @default(5)
  availableAt     DateTime       @default(now())
  lockedAt        DateTime?
  lastError       String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  uploadSession MediaUploadSession? @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  asset         GalleryAsset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([assetId, status])
}

model GalleryShareLink {
  id             String    @id @default(cuid())
  galleryId      String
  slug           String    @unique
  tokenHash      String?   @unique
  grantVersion   Int       @default(1)
  passwordHash   String?
  recipientEmail String?
  expiresAt      DateTime?
  maxDownloads   Int?
  downloadCount  Int       @default(0)
  isActive       Boolean   @default(true)
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, isActive])
}

model StorageDeletionJob {
  id          String                @id @default(cuid())
  storageArea StorageArea
  objectKey   String
  status      StorageDeletionStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([storageArea, objectKey])
  @@index([status, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model SecurityAuditEvent {
  id           String   @id @default(cuid())
  eventType    String
  outcome      String
  actorHash    String?
  ipHash       String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
}

model Ticket {
  id              String       @id @default(cuid())
  type            TicketType
  source          TicketSource
  status          TicketStatus @default(NEW)
  firstName       String
  lastName        String
  email           String
  telephone       String?
  whatsapp        String?
  message         String?
  eventDate       DateTime?
  eventType       String?
  eventDuration   String?
  guestCount      Int?
  additionalNotes String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messages TicketMessage[]

  @@index([type, status, createdAt])
  @@index([email, createdAt])
}

model TicketMessage {
  id           String    @id @default(cuid())
  ticketId     String
  actorType    ActorType
  actorLabel   String?
  emailTo      String?
  emailSubject String?
  bodyText     String?
  bodyHtml     String?
  createdAt    DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model EmailLog {
  id                String   @id @default(cuid())
  provider          String   @default("resend")
  templateKey       String
  toEmail           String
  subject           String
  providerMessageId String?
  status            String
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([toEmail, createdAt])
}

model SiteContent {
  key                  String   @id
  title                String?
  subtitle             String?
  body                 String?
  ctaTitle             String?
  ctaBody              String?
  imageObjectKey       String?
  imageSmallObjectKey  String?
  imageSmallWidth      Int?
  imageSmallHeight     Int?
  imageSmallSizeBytes  BigInt?
  imageMediumObjectKey String?
  imageMediumWidth     Int?
  imageMediumHeight    Int?
  imageMediumSizeBytes BigInt?
  imageAlt             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
